databases/

# Local AI runtime binaries are installed/generated on the developer machine.
desktop/AI/runtime/*
!desktop/AI/runtime/*.py

# Live acceptance evidence is generated from local/provider/marketplace sessions.
# Keep the executable harnesses and human-readable contracts in Git; keep raw
# transcripts, Stage snapshots and regenerated closure reports on the machine
# that produced them.
desktop/AI/docs/live_llm_transcripts/
desktop/AI/docs/stage-acceptance/
desktop/AI/docs/agentic_control_plane_*.json
desktop/AI/docs/current_acceptance_manifest.json
desktop/AI/docs/orders_goal_closure_latest_report.json

